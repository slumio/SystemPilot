FROM rust:1.88-bookworm AS builder
WORKDIR /source
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY crates ./crates
COPY tools ./tools
RUN cargo build --locked --release -p syspilot-fleet-loadtest

FROM debian:bookworm-slim
RUN useradd --create-home --uid 10001 loadtest
COPY --from=builder /source/target/release/syspilot-fleet-loadtest /usr/local/bin/syspilot-fleet-loadtest
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/syspilot-fleet-loadtest"]
