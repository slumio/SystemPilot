[Unit]
Description=SysPilot process telemetry daemon (legacy unit name)
Documentation=https://github.com/slumio/g
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syspilot
Group=syspilot
Environment=SYSPILOT_HOME=/var/lib/syspilot
Environment=SYSPILOT_RUNTIME_DIR=/run/syspilot
ExecStart=/usr/bin/syspilot daemon
Restart=on-failure
RestartSec=3s
RuntimeDirectory=syspilot
RuntimeDirectoryMode=0750
StateDirectory=syspilot
StateDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/syspilot /run/syspilot

[Install]
WantedBy=multi-user.target
