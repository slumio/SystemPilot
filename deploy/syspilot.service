[Unit]
Description=SysPilot process telemetry daemon
Documentation=https://github.com/slumio/SystemPilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syspilot
Group=syspilot
Environment=SYSPILOT_HOME=/var/lib/syspilot
Environment=SYSPILOT_RUNTIME_DIR=/run/syspilot
# Resolve optional credentials from systemd's credential store. Administrators
# may provision these under /etc/credstore; absence keeps local diagnostics live.
LoadCredential=gemini-api-key
LoadCredential=syspilot-api-key
LoadCredential=telemetry-token
LoadCredential=fleet-token
ExecStart=/usr/bin/syspilot daemon
Restart=on-failure
RestartSec=3s
RuntimeDirectory=syspilot
RuntimeDirectoryMode=0750
StateDirectory=syspilot
StateDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/syspilot /run/syspilot

[Install]
WantedBy=multi-user.target
